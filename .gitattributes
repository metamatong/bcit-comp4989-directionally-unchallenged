# Geometry hashes cover exact bytes; Windows checkouts must retain LF endings.
data/campus/visual/geometry/*.json text eol=lf
data/campus/spatial/*.json text eol=lf
data/campus/spatial/*.sha256 text eol=lf
data/campus/geolocation/calibrations.json text eol=lf
data/campus/geolocation/bcit-pilot-footprints.json -text

# Preserve source documents and derived images byte-for-byte.
*.pdf -text
*.png -text
