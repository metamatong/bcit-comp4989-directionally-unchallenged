# Select gemini, openai, or groq for both photo-analysis stages. Default: gemini.
AI_PROVIDER=gemini
# Keep keys server-side; never put them in VITE_* variables.
GEMINI_API_KEY=
# Google documents this multimodal model on its free tier.
GEMINI_MODEL=gemini-3.5-flash-lite
# Ordered fallback list; fallback models must also be eligible on your API project's free tier.
GEMINI_FALLBACK_MODELS=gemini-3.8-flash
# Set true only after verifying this API project uses an eligible free tier.
AI_FREE_TIER_CONFIRMED=false
# Optional OpenAI API key; not required while AI_PROVIDER=gemini.
OPENAI_API_KEY=
# luna-6.0 is an app alias for the documented OpenAI API ID gpt-6-luna.
# Other image/function-capable OpenAI model IDs can be set directly.
OPENAI_MODEL=luna-6.0
# Optional Groq API key; create one in GroqCloud and keep it server-side.
GROQ_API_KEY=
# Groq model with vision and function calling support. Check current pricing and quota.
GROQ_MODEL=qwen/qwen3.8-27b
AI_REQUESTS_PER_MINUTE=6
AI_REQUESTS_PER_DAY=60
# Attempt timeout before switching to another healthy configured model (milliseconds).
AI_TIMEOUT_MS=15000
PORT=3000
HOST=127.0.0.1
