# Gemini is required for photo analysis. Configure the key on the server.
# Keep keys server-side; never put them in VITE_* variables.
GEMINI_API_KEY=
# Google documents this multimodal model on its free tier.
GEMINI_MODEL=gemini-3.5-flash-lite
# Ordered fallback list; fallback models must also be eligible on your API project's free tier.
GEMINI_FALLBACK_MODELS=gemini-3.8-flash
# Set true only after verifying this API project uses an eligible free tier.
AI_FREE_TIER_CONFIRMED=false
AI_REQUESTS_PER_MINUTE=6
AI_REQUESTS_PER_DAY=60
AI_TIMEOUT_MS=15000
PORT=3000
HOST=127.0.0.1
