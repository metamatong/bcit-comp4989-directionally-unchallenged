# Select gemini, openai, or groq for photo evidence extraction. Default: gemini.
AI_PROVIDER=gemini
# Keep keys server-side; never put them in VITE_* variables.
GEMINI_API_KEY=
# Optional ordered backups for independently authorized quota. Keys in one project share quota.
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
# Google documents this multimodal model on its free tier.
GEMINI_MODEL=gemini-3.5-flash-lite
# Ordered fallback list; fallback models must also be eligible on your API project's free tier.
GEMINI_FALLBACK_MODELS=gemini-3.8-flash
# Set true only after verifying free-tier eligibility for each configured Gemini project.
AI_FREE_TIER_CONFIRMED=false
# Optional OpenAI API key; not required while AI_PROVIDER=gemini.
OPENAI_API_KEY=
# luna-6.0 is an app alias for the documented OpenAI API ID gpt-6-luna.
# Other image/function-capable OpenAI model IDs can be set directly.
OPENAI_MODEL=luna-6.0
# Optional Groq API key; create one in GroqCloud and keep it server-side.
GROQ_API_KEY=
# Groq model with vision and function calling support. Check current pricing and quota.
GROQ_MODEL=qwen/qwen3.8-27b
AI_REQUESTS_PER_MINUTE=6
AI_REQUESTS_PER_DAY=60
# Gemini failover threshold and default for unscoped calls (milliseconds).
# Photo stages use shared 45s/90s deadlines; navigation uses 90s.
AI_TIMEOUT_MS=15000
PORT=3000
HOST=127.0.0.1
# Local testing only: bypass photo GPS and disable live location tracking.
# This setting is ignored in production and hosted deployments.
GPS_TEST_MODE=false
