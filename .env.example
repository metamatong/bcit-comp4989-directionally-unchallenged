# Gemini is required for photo analysis. The official plan library works without a key.
# Keep keys server-side; never put them in VITE_* variables.
GEMINI_API_KEY=
# Supported: gemini-3.5-flash-lite, gemini-3.6-flash, gemini-3.8-flash
GEMINI_MODEL=gemini-3.5-flash-lite
# Set true only after verifying this API project uses an eligible free tier.
AI_FREE_TIER_CONFIRMED=false
AI_REQUESTS_PER_MINUTE=6
AI_REQUESTS_PER_DAY=60
AI_TIMEOUT_MS=15000
PORT=3000
HOST=127.0.0.1
